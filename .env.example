# ============================================================================
# dsh-aiops-kits-offline 环境变量模板
# 用法：cp .env.example .env 后按需修改。.env 不入 git（含密钥）。
# ============================================================================

# --- 镜像 ---
# 本机 x86 开发机用 amd64 标签；内网 arm64 机器改用 arm64 标签 + docker-compose.arm.yml
DSH_IMAGE=rocky8-pygojava-wwt_amd64:v20260817
# DSH_IMAGE=rocky8-pygojava-wwt_arm64:v20260817

# --- 模型 API（可选；也可在容器内设置） ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# --- 本地模型（llm-pi-ai 路由 local，OpenAI 兼容） ---
UNSLOTH_API_KEY=

# --- 网络绑定与信任围栏（★ 换 IP 必看） ---
# DSH_BIND：dsh web 监听地址。127.0.0.1=仅本机；0.0.0.0=允许局域网/公网（服务器部署，见 docs/03）
DSH_BIND=127.0.0.1

# DSH_TRUSTED_HOSTS：允许做配置管理(settings/模型/凭据)的 LAN 主机，逗号分隔。
# ★ 机器换了 IP 后必须改成新 IP（例如 192.168.1.50）：
#   1) 改这里；2) 重跑 bash scripts/apply-runtime-fixes.sh <新IP>；3) docker compose up -d
DSH_TRUSTED_HOSTS=

# --- 对外端口（docker-proxy 映射） ---
# 宿主端口 → 容器 3080。0.0.0.0:9488 = 对所有网卡开放；127.0.0.1:9488 = 仅本机
DSH_PUBLIC_PORT=0.0.0.0:9488

# --- 其他 ---
# 容器内 socat 桥接端口（一般不用改）
# DSH_SOCAT_PORT=3090
