docker run -it --name temp-dsh rocky8-pygojava-wwt_amd64:v20260709 /bin/bash
npm pack @deepseek-ai/dsh
ls
pwd
exit

docker cp temp-dsh:/app/deepseek-ai-dsh-0.1.0-rc.6.tgz ./
docker rm temp-dsh

services:
  deepseek-harness:
    # 直接使用您现有的 ARM 镜像，不构建新镜像
    image: rocky8-pygojava-wwt_arm64:latest
    container_name: deepseek-harness
    ports:
      - "3080:3080"
    volumes:
      # 【必须】持久化数据目录，保存会话、API Key 等
      - ./data:/root/.dsh
      # 【推荐】工作区目录，AI 可读写此处的文件
      - ./workspace:/workspace
      # 【关键】挂载您存放离线 tgz 包的文件夹
      - ./packages:/opt/packages
    environment:
      - DSH_TELEMETRY_DISABLED=1
    # 启动命令：先安装（仅首次），再运行
    command: >
      sh -c "
        if [ ! -f /opt/packages/.installed ]; then
          echo '正在离线安装 dsh ...' &&
          npm install -g /opt/packages/*.tgz --no-save &&
          touch /opt/packages/.installed &&
          echo '安装完成';
        else
          echo 'dsh 已安装，跳过安装步骤';
        fi &&
        dsh web --host 0.0.0.0
      "
    restart: unless-stopped


=====================
.
├── docker-compose.yml
├── data/               # 自动创建，存放 dsh 配置/会话
├── workspace/          # 自动创建，放您的项目文件
└── packages/           # 手动创建，放入离线 tgz 包
    ├── deepseek-ai-dsh-0.1.0.tgz
    ├── axios-1.6.0.tgz        # 示例：dsh 的依赖包
    └── ...                     # 其他依赖包

